{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hrsu-indore",
  "main": "_worker.js",
  "compatibility_date": "2026-05-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/css/*", "!/js/*", "!/images/*", "!/*.pdf", "!/*.png", "!/*.jpg", "!/*.jpeg", "!/*.webp", "!/*.svg", "!/*.ico"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
